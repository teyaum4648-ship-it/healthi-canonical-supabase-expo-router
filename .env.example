EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
EXPO_PUBLIC_LAB_EVIDENCE_ENABLED=false
# Hosted web: same-origin search gateway. On a phone a relative path is joined to
# EXPO_PUBLIC_SITE_URL below, so setting the site address connects phone search (USDA
# included) to the same server. An absolute https:// URL here is used as-is.
EXPO_PUBLIC_FOOD_SEARCH_URL=/api/food-search
# USDA_API_KEY is a SERVER runtime secret only. Never prefix it EXPO_PUBLIC_.
# Optional: v5_two_axis reproduces the temporary ZIP-based scanner demo.
# Leave empty to retain the standard scoring engine. Restart/rebuild after changing.
EXPO_PUBLIC_PRODUCT_QUALITY_EXPERIMENT=
# Absolute origin of the public site, e.g. https://healthi.example.com — no trailing slash.
# The web export can use relative paths, but a NATIVE build has no origin of its own, so
# without this the in-app links to the legal pages render as plain text instead of links.
# Required before any App Store or Play submission.
EXPO_PUBLIC_SITE_URL=
# Waitlist (/api/waitlist on the web Worker). These are Worker settings, not app variables:
#   npx wrangler secret put SUPABASE_URL
#   npx wrangler secret put SUPABASE_ANON_KEY
# The anon key is the same public key as EXPO_PUBLIC_SUPABASE_ANON_KEY; it can only call
# join_waitlist, which inserts and returns nothing.
