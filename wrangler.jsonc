{
  // Serves the exported web app, the waitlist page at /, and the /api/food-search and
  // /api/waitlist routes from one Worker. /api/waitlist needs SUPABASE_URL and
  // SUPABASE_ANON_KEY: `npx wrangler secret put SUPABASE_URL` (and the same for the key).
  //
  // The Worker only runs for /api/* — everything else is served straight from the
  // edge as a static asset, which is faster and cheaper than routing every request
  // through script. Deep links are handled by not_found_handling rather than by the
  // Worker's own fallback, so a refresh on /food resolves to the app shell.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "healthi-demo",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // "/" too, so the front door can be the waitlist page rather than the app shell.
    "run_worker_first": ["/api/*", "/"]
  },
  "observability": {
    "enabled": true
  }
}
